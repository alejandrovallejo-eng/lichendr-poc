NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Real data workflows are enabled when connection variables are configured.
# Set to 1 only for an explicitly requested visual preview without data access.
LICHENDR_PREVIEW_ONLY=0
VISION_SERVICE_URL=https://your-render-service.onrender.com
VISION_SERVICE_TOKEN=replace-with-a-secure-random-token

# Piloto BioCLIP + MobileSAM (revisión asistida de regiones). Apagado por
# defecto: con el flag distinto de "1" no se hace ninguna llamada a BioCLIP.
NEXT_PUBLIC_BIOCLIP_SUGGESTIONS=0
# Segmentación independiente de la clasificación BioCLIP.
NEXT_PUBLIC_MOBILESAM_ASSISTANCE=1
# Worker local (http://127.0.0.1:8500) o Cloud Run privado existente.
# Vacío = asistencia desactivada. Ver docs/AI_SETUP.md para autenticación.
BIOCLIP_WORKER_URL=
BIOCLIP_WORKER_TOKEN=
BIOCLIP_PREPROCESS_MODE=whole_crop_pad

# En Vercel se usa directamente el worker Cloud Run con BIOCLIP_GOOGLE_IAM=1.
BIOCLIP_GOOGLE_IAM=0
# Para acceder al MISMO Cloud Run desde esta Mac con Google Cloud CLI autenticado.
# Requiere BIOCLIP_WORKER_URL, su token existente y permiso Cloud Run Invoker.
BIOCLIP_GOOGLE_DEVELOPER_AUTH=0
BIOCLIP_GCLOUD_PATH=
