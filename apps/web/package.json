{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:onnx": "node scripts/copy-onnx-runtime.mjs",
    "predev": "npm run prepare:onnx",
    "dev": "next dev",
    "prebuild": "npm run prepare:onnx",
    "build": "next build",
    "postbuild": "node scripts/verify-sharp-runtime.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:proxy && npm run test:ready && npm run test:routes",
    "test:ready": "rm -rf /tmp/lichendr-ready-tests && tsc -p tsconfig.test-ready.json && node --test /tmp/lichendr-ready-tests/vision-ready.test.js",
    "test:unit": "rm -rf /tmp/lichendr-web-tests && tsc -p tsconfig.test-unit.json && NODE_PATH=$PWD/node_modules node --test /tmp/lichendr-web-tests/modules/annotations/annotation-target.test.js /tmp/lichendr-web-tests/modules/annotations/studio-mask-utils.test.js /tmp/lichendr-web-tests/modules/dashboard/home-data.test.js /tmp/lichendr-web-tests/modules/environmental-quality/science.test.js /tmp/lichendr-web-tests/modules/images/persistence.test.js /tmp/lichendr-web-tests/modules/four-view/assistance.test.js /tmp/lichendr-web-tests/modules/four-view/capture-flow.test.js /tmp/lichendr-web-tests/modules/four-view/capture-run.test.js /tmp/lichendr-web-tests/modules/four-view/manual-flow.test.js /tmp/lichendr-web-tests/modules/four-view/metrics.test.js /tmp/lichendr-web-tests/modules/four-view/science.test.js /tmp/lichendr-web-tests/modules/four-view/navigation.test.js /tmp/lichendr-web-tests/modules/four-view/stored-analysis.test.js /tmp/lichendr-web-tests/modules/four-view/cell-frequency.test.js /tmp/lichendr-web-tests/modules/four-view/ecology-standardized.test.js /tmp/lichendr-web-tests/modules/prepare-day/logic.test.js /tmp/lichendr-web-tests/modules/region-suggestions/crop-geometry.test.js /tmp/lichendr-web-tests/modules/region-suggestions/review.test.js /tmp/lichendr-web-tests/modules/region-suggestions/coverage.test.js /tmp/lichendr-web-tests/modules/region-suggestions/flag.test.js /tmp/lichendr-web-tests/modules/region-suggestions/client.test.js /tmp/lichendr-web-tests/modules/region-suggestions/mask-codec.test.js /tmp/lichendr-web-tests/modules/region-suggestions/mask-edit.test.js /tmp/lichendr-web-tests/modules/region-suggestions/sam-service.test.js",
    "test:proxy": "rm -rf /tmp/lichendr-proxy-tests && tsc -p tsconfig.test-proxy.json && NODE_PATH=$PWD/node_modules node --test /tmp/lichendr-proxy-tests/vision-analysis-image.test.js /tmp/lichendr-proxy-tests/vision-analysis-proxy.test.js",
    "test:routes": "rm -rf /tmp/lichendr-route-tests && tsc -p tsconfig.test-routes.json && NODE_PATH=$PWD/node_modules node --test /tmp/lichendr-route-tests/modules/region-suggestions/server/routes.test.js",
    "test:component": "rm -rf /tmp/lichendr-component-tests && tsc -p tsconfig.component-tests.json && NODE_PATH=$PWD/node_modules:$PWD/test-stubs node --test /tmp/lichendr-component-tests/modules/region-suggestions/panel.component.test.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "exifr": "^7.1.3",
    "heic-decode": "2.1.0",
    "konva": "^10.3.0",
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-konva": "^19.2.5",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4"
  }
}
